# HandyMouseCam Environment Variables Example
# Copy this file to .env and adjust values as needed

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_PORT=5000
FLASK_HOST=0.0.0.0

# Hand Tracking Sensitivity
CURSOR_SENSITIVITY=1.5
USE_WEBRTC=true
LOCAL_CAMERA_INDEX=0
LOCAL_CAMERA_WIDTH=640
LOCAL_CAMERA_HEIGHT=480
LOCAL_CAMERA_FPS=30
RETURN_ANNOTATED_VIDEO=false
HAND_DETECTION_CONFIDENCE=0.7
PINCH_DISTANCE_THRESHOLD_MM=30

# Logging
LOG_LEVEL=INFO

# Network
QR_CODE_OUTPUT_PATH=qr_code.png
